# Copy to .env and fill in real values locally. .env is gitignored — never commit it.
# Names only here, no real values or secrets.

# Storage backend selector: "sqlite" (default, local dev) or "postgres" (Phase 10 - hosted
# deployment; see docs/ARCHITECTURE.md#storage). Every module under data_dir (research,
# content, decisions, the pick ledger, public predictions, live odds snapshots, the
# event/game mapping index, and the teams/games relational tables) supports both backends
# transparently through src/nfl_predict/storage/blob_store.py and src/nfl_predict/data/db.py.
NFL_STORAGE_BACKEND=sqlite

# Only used when NFL_STORAGE_BACKEND=postgres. Full connection string, including credentials.
# Requires the `postgres` extra installed (pip install -e .[postgres]).
NFL_DATABASE_URL=

# Test-only: points tests/storage/test_postgres_blob_store.py and
# tests/data/test_postgres_connection.py at a real, disposable Postgres database. Leave
# unset locally - if the `postgres` extra is installed, tests/conftest.py automatically
# starts a real embedded Postgres for the test session and sets this itself; set it
# explicitly only to point at a specific external instance (e.g. in CI).
NFL_TEST_POSTGRES_URL=

# Overrides where SQLite/Parquet files live locally. Defaults to ./data if unset.
NFL_DATA_DIR=

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL. Defaults to INFO.
NFL_LOG_LEVEL=INFO

# --- Added in later phases, listed here as placeholders so the env-var surface is visible ---

# Live odds provider key for The Odds API (Phase 5 — see docs/DATA_SOURCES.md and
# src/nfl_predict/market/odds_provider.py). Leave unset to run with only the fixture-backed
# provider; live authenticated calls are refused (not fabricated) until this is set.
NFL_ODDS_API_KEY=

# LLM API key for the research agent (Phase 6 — see docs/PHASE6_RESEARCH_AGENT_REPORT.md
# and src/nfl_predict/research/llm_provider.py). Deliberately project-scoped, not the
# ambient ANTHROPIC_API_KEY a host environment might set for unrelated purposes. Leave
# unset to run with only the fixture-backed provider; live calls are refused, not fabricated.
NFL_RESEARCH_LLM_API_KEY=

# Weather API key (Phase 6 — provider not yet chosen, see docs/DATA_SOURCES.md and
# src/nfl_predict/research/current_data_providers.py). Leave unset to use fixtures only.
NFL_WEATHER_API_KEY=

# News research API key (Phase 6 — provider not yet chosen, see docs/DATA_SOURCES.md
# and src/nfl_predict/research/current_data_providers.py). Leave unset to use fixtures only.
NFL_NEWS_API_KEY=

# Structured injury-data provider key (Phase 8A — a direct feed of official injury
# designations, distinct from the LLM/web research provider above; provider not yet chosen,
# see docs/DATA_SOURCES.md and src/nfl_predict/research/current_data_providers.py). Leave
# unset to use fixtures only; live calls are refused, not fabricated.
NFL_INJURY_API_KEY=

# Hard per-run cap on The Odds API credits (Phase 8A correction — see
# docs/PHASE8A_LIVE_PIPELINE_REPORT.md's credit-exhaustion postmortem). A full NFL-slate
# refresh costs 2 credits (spreads,h2h x us region); defaults to 5 if unset.
NFL_ODDS_MAX_CREDITS_PER_RUN=

# Hard per-matchup cap on Anthropic web-search tool calls during research (Phase 8A
# cost-controls correction). Defaults to 3 if unset.
NFL_RESEARCH_MAX_WEB_SEARCHES_PER_GAME=

# Pre-flight per-game cost cap in USD (Phase 8A cost-controls correction) - a research call
# whose known-floor cost (max_tokens output + web searches, from config/llm_pricing.yaml) is
# already above this is refused before any HTTP request is made. Defaults to 1.00 if unset.
NFL_RESEARCH_MAX_ESTIMATED_COST_PER_GAME=

# Hard cap on how many games get a real research call in one run when --research-all is not
# passed (Phase 8A cost-controls correction). Defaults to 3 if unset.
NFL_RESEARCH_MAX_GAMES_PER_RUN=

# Pre-flight per-game cost cap in USD for the prediction-writer content step (Phase 8B
# follow-up — see src/nfl_predict/content/prediction_writer.py). Same guard mechanism as
# NFL_RESEARCH_MAX_ESTIMATED_COST_PER_GAME, much cheaper since no web search is used.
# Defaults to 0.05 if unset; set to empty/0 to disable the cap.
NFL_CONTENT_MAX_COST_PER_GAME=
